    "For the waveform and the volume slider. Nothing is recorded or leaves your Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للموجة الصوتية وشريط مستوى الصوت. لا يتم تسجيل أي شيء ولا يغادر جهاز Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per a la forma d’ona i el regulador de volum. No es grava res ni surt del teu Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vlnu a jezdec hlasitosti. Nic se nenahrává ani neopouští váš Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til bølgeformen og lydstyrkeknappen. Intet optages eller forlader din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Wellenform und den Lautstärkeregler. Nichts wird aufgezeichnet oder verlässt deinen Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την κυματομορφή και το ρυθμιστικό έντασης. Τίποτα δεν εγγράφεται ούτε φεύγει από το Mac σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la forma de onda y el regulador de volumen. Nada se graba ni sale de tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aaltomuodolle ja äänenvoimakkuuden liukusäätimelle. Mitään ei tallenneta eikä mikään poistu Macilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la forme d’onde et le curseur de volume. Rien n’est enregistré ni ne quitte votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור צורת הגל ומחוון עוצמת הקול. שום דבר לא מוקלט או יוצא מה-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेवफ़ॉर्म और वॉल्यूम स्लाइडर के लिए। कुछ भी रिकॉर्ड नहीं होता और न ही आपके Mac से बाहर जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za valni oblik i klizač glasnoće. Ništa se ne snima niti napušta vaš Mac."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hullámformához és a hangerőszabályzóhoz. Semmi sem kerül rögzítésre, és nem hagyja el a Macet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bentuk gelombang dan penggeser volume. Tidak ada yang direkam atau keluar dari Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la forma d’onda e il cursore del volume. Nulla viene registrato o lascia il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波形と音量スライダー用。何も録音されず、Macの外に送信されることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형과 음량 슬라이더용입니다. 아무것도 녹음되거나 Mac 밖으로 나가지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk bentuk gelombang dan peleret kelantangan. Tiada apa-apa dirakam atau meninggalkan Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For bølgeformen og volumkontrollen. Ingenting tas opp eller forlater Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de golfvorm en de volumeregelaar. Niets wordt opgenomen of verlaat je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do fali dźwiękowej i suwaka głośności. Nic nie jest nagrywane ani nie opuszcza Twojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a forma de onda e o controle de volume. Nada é gravado nem sai do seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a forma de onda e o nível de volume. Nada é gravado nem sai do seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru forma de undă și glisorul de volum. Nimic nu este înregistrat și nu părăsește Mac-ul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для волны и регулятора громкости. Ничего не записывается и не покидает ваш Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vlnu a posuvník hlasitosti. Nič sa nenahráva ani neopúšťa váš Mac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za valovno obliko in drsnik glasnosti. Nič se ne snema in ne zapusti vašega Maca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För vågformen och volymreglaget. Inget spelas in eller lämnar din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับรูปคลื่นและแถบเลื่อนระดับเสียง ไม่มีการบันทึกหรือส่งสิ่งใดออกจาก Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalga biçimi ve ses sürgüsü için. Hiçbir şey kaydedilmez ve Mac’inizden çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для хвилі та регулятора гучності. Нічого не записується й не залишає ваш Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho dạng sóng và thanh trượt âm lượng. Không có gì được ghi lại hay rời khỏi máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于波形和音量滑块。不会录制任何内容，也不会传出你的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於波形和音量滑桿。不會錄製任何內容，也不會傳出你的 Mac。"
          }
        }
      }
    },
