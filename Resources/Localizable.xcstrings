    "Allow it in Privacy & Security, under Accessibility.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بذلك في الخصوصية والأمن، ضمن تسهيلات الاستخدام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet-ho a Privacitat i seguretat, a Accessibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte v sekci Soukromí a zabezpečení, v části Zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad det i Anonymitet & sikkerhed under Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube es unter Datenschutz & Sicherheit in Bedienungshilfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το στην ενότητα Απόρρητο και ασφάλεια, στο Προσβασιμότητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítelo en Privacidad y seguridad, en Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli se kohdassa Tietosuoja ja suojaus, Käyttöapu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez-le dans Confidentialité et sécurité, sous Accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאשר בפרטיות ואבטחה, תחת נגישות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीयता और सुरक्षा में, ऐक्सेसिबिलिटी के अंतर्गत अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite u odjeljku Privatnost i sigurnost, pod Pristupačnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze itt: Adatvédelem és biztonság > Kisegítő lehetőségek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan di Privasi & Keamanan, pada Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentilo in Privacy e sicurezza, sotto Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ」の「アクセシビリティ」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안의 손쉬운 사용에서 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan dalam Privasi & Keselamatan, di bawah Kebolehcapaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat det i Personvern og sikkerhet, under Tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta het toe bij Privacy en beveiliging, onder Toegankelijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól w sekcji Prywatność i ochrona, w części Dostępność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita em Privacidade e Segurança, em Acessibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize em Privacidade e segurança, em Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți în Intimitate și securitate, la Accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите в разделе «Конфиденциальность и безопасность», пункт «Универсальный доступ»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte v sekcii Súkromie a bezpečnosť, v časti Prístupnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite v razdelku Zasebnost in varnost, pod Dostopnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt det i Integritet och säkerhet, under Hjälpmedel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตใน ความเป็นส่วนตัวและความปลอดภัย ภายใต้ การช่วยการเข้าถึง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik bölümünde, Erişilebilirlik altında izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте в розділі «Приватність і безпека», пункт «Доступність»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép trong Quyền riêng tư & Bảo mật, tại Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全”的“无障碍”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「隱私權與安全性」的「輔助使用」中允許。"
          }
        }
      }
    },
    "Allow it in Privacy & Security, under Paste from Other Apps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بذلك في الخصوصية والأمن، ضمن اللصق من تطبيقات أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet-ho a Privacitat i seguretat, a Enganxa des d’altres apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte v sekci Soukromí a zabezpečení, v části Vkládání z jiných aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad det i Anonymitet & sikkerhed under Sæt ind fra andre apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube es unter Datenschutz & Sicherheit in Aus anderen Apps einsetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το στην ενότητα Απόρρητο και ασφάλεια, στο Επικόλληση από άλλες εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permítelo en Privacidad y seguridad, en Pegar desde otras apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli se kohdassa Tietosuoja ja suojaus, Sijoita muista apeista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez-le dans Confidentialité et sécurité, sous Coller depuis d’autres apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאשר בפרטיות ואבטחה, תחת הדבקה מיישומים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गोपनीयता और सुरक्षा में, अन्य ऐप्स से पेस्ट करें के अंतर्गत अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopustite u odjeljku Privatnost i sigurnost, pod Lijepljenje iz drugih aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezze itt: Adatvédelem és biztonság > Beillesztés más appokból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan di Privasi & Keamanan, pada Tempelkan dari App Lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentilo in Privacy e sicurezza, sotto Incolla da altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ」の「ほかのアプリからペースト」で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보 보호 및 보안의 다른 앱에서 붙여넣기에서 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan dalam Privasi & Keselamatan, di bawah Tampal daripada App Lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat det i Personvern og sikkerhet, under Lim inn fra andre apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta het toe bij Privacy en beveiliging, onder Plak uit andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól w sekcji Prywatność i ochrona, w części Wklejanie z innych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita em Privacidade e Segurança, em Colar de Outros Apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorize em Privacidade e segurança, em Colar de outras aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți în Intimitate și securitate, la Lipire din alte aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите в разделе «Конфиденциальность и безопасность», пункт «Вставка из других приложений»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoľte v sekcii Súkromie a bezpečnosť, v časti Vkladanie z iných apiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovolite v razdelku Zasebnost in varnost, pod Lepljenje iz drugih aplikacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt det i Integritet och säkerhet, under Klistra in från andra appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตใน ความเป็นส่วนตัวและความปลอดภัย ภายใต้ วางจากแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik bölümünde, Diğer Uygulamalardan Yapıştır altında izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте в розділі «Приватність і безпека», пункт «Вставлення з інших програм»."
          }
        },
        "vi": {
