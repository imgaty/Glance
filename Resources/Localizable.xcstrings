    "Counts down beside the camera, and says when it's done.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدّ تنازليًا بجانب الكاميرا ويخبرك عند الانتهاء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa el compte enrere al costat de la càmera i avisa quan acaba."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočítává vedle kamery a oznámí konec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller ned ved siden af kameraet og siger til, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt neben der Kamera herunter und meldet das Ende."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρά αντίστροφα δίπλα στην κάμερα και ειδοποιεί στο τέλος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace la cuenta atrás junto a la cámara y avisa al terminar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskee alaspäin kameran vieressä ja kertoo, kun aika on täynnä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait le compte à rebours à côté de la caméra et signale la fin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סופר לאחור ליד המצלמה ומודיע בסיום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा के पास काउंटडाउन करता है और समाप्त होने पर बताता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbrojava pored kamere i javlja kad završi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaszámol a kamera mellett, és jelzi, ha lejárt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghitung mundur di samping kamera, dan memberi tahu saat selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa il conto alla rovescia accanto alla fotocamera e avvisa alla fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの横でカウントダウンし、終わるとお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 옆에서 카운트다운하고 끝나면 알려줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengira detik di sebelah kamera, dan memberitahu apabila selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller ned ved siden av kameraet og sier fra når det er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt af naast de camera en meldt wanneer het klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odlicza czas obok kamery i informuje o końcu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz a contagem regressiva ao lado da câmera e avisa quando termina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz a contagem decrescente ao lado da câmara e avisa quando termina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numără invers lângă cameră și anunță când s-a terminat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведёт обратный отсчёт рядом с камерой и сообщает об окончании."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpočítava vedľa kamery a oznámi koniec."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odšteva poleg kamere in pove, ko konča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknar ner bredvid kameran och säger till när det är klart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับถอยหลังข้างกล้องและแจ้งเมื่อเสร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın yanında geri sayar ve bitince bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веде зворотний відлік поруч із камерою та повідомляє про завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm ngược bên cạnh camera và báo khi xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机旁倒计时，结束时提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相機旁倒數計時，結束時提醒。"
          }
        }
      }
    },
