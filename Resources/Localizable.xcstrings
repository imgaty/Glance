    "Files you drop and what you copy, close at hand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات التي تفلتها وما تنسخه، في متناول يدك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els fitxers que deixes anar i el que copies, a mà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetažené soubory a to, co kopírujete, po ruce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiver du slipper, og det du kopierer, lige ved hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelegte Dateien und Kopiertes, griffbereit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία που αφήνετε και όσα αντιγράφετε, κοντά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que sueltas y lo que copias, siempre a mano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudottamasi tiedostot ja kopioimasi asiat lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers que vous déposez et ce que vous copiez, à portée de main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים ששחררת ומה שהעתקת, בהישג יד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ड्रॉप की हुई फ़ाइलें और कॉपी की हुई चीज़ें, हाथ के पास।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispuštene datoteke i ono što kopirate, pri ruci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bedobott fájlok és amit másol, kéznél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang Anda letakkan dan yang Anda salin, selalu dekat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che trascini e ciò che copi, a portata di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドロップしたファイルとコピーしたものを手元に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "놓은 파일과 복사한 항목을 가까이에."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail yang anda lepaskan dan yang anda salin, sentiasa dekat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer du slipper og det du kopierer, lett tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden die je neerzet en wat je kopieert, altijd bij de hand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuszczone pliki i to, co kopiujesz, pod ręką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos que você solta e o que copia, sempre à mão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros que larga e o que copia, sempre à mão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele plasate și ce copiați, la îndemână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащенные файлы и скопированное всегда под рукой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretiahnuté súbory a to, čo kopírujete, poruke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spuščene datoteke in kar kopirate, pri roki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer du släpper och det du kopierar, nära till hands."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่คุณวางและสิ่งที่คุณคัดลอก อยู่ใกล้มือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bıraktığınız dosyalar ve kopyaladıklarınız, elinizin altında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягнуті файли та скопійоване завжди під рукою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp bạn thả và nội dung bạn sao chép, luôn trong tầm tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放的文件和拷贝的内容，随手可取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖放的檔案和拷貝的內容，隨手可得。"
          }
        }
      }
    },
