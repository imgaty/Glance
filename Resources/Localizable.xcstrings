    "Warns at 20% and again at 10%.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينبّه عند 20% ومرة أخرى عند 10%."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa al 20% i de nou al 10%."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorní při 20 % a znovu při 10 %."
          }
