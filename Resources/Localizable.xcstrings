    "Plays the album cover's animated version, if it has one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل النسخة المتحركة من غلاف الألبوم، إن وجدت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodueix la versió animada de la portada de l’àlbum, si n’hi ha."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehraje animovanou verzi obalu alba, pokud existuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller den animerede version af albumcoveret, hvis der er en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt die animierte Version des Albumcovers ab, falls es eine gibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει την κινούμενη έκδοση του εξωφύλλου, αν υπάρχει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce la versión animada de la portada del álbum, si la tiene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaa albumin kannen animoidun version, jos sellainen on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la version animée de la pochette de l’album, s’il y en a une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנגן את הגרסה המונפשת של עטיפת האלבום, אם יש כזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि हो तो एल्बम कवर का ऐनिमेटेड संस्करण चलाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducira animiranu verziju omota albuma, ako postoji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lejátssza az albumborító animált változatát, ha van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar versi animasi sampul album, jika ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce la versione animata della copertina dell’album, se esiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムカバーのアニメーション版があれば再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 커버의 움직이는 버전이 있으면 재생합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memainkan versi animasi kulit album, jika ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller av den animerte versjonen av albumomslaget, hvis den finnes."
          }
        },
        "nl": {
