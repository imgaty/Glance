            "value": "傳送到 %@"
          }
        }
      }
    },
    "To keep what you copy, allow Glance in Privacy & Security, under Paste from Other Apps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاحتفاظ بما تنسخه، اسمح لـ Glance في الخصوصية والأمن، ضمن اللصق من تطبيقات أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conservar el que copies, permet el Glance a Privacitat i seguretat, a Enganxa des d’altres apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li ponechávat, co kopírujete, povolte Glance v sekci Soukromí a zabezpečení, v části Vkládání z jiných aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Glance i Anonymitet & sikkerhed under Sæt ind fra andre apps for at beholde det, du kopierer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Kopiertes zu behalten, erlaube Glance unter Datenschutz & Sicherheit in Aus anderen Apps einsetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να διατηρείτε όσα αντιγράφετε, επιτρέψτε το Glance στην ενότητα Απόρρητο και ασφάλεια, στο Επικόλληση από άλλες εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conservar lo que copias, permite Glance en Privacidad y seguridad, en Pegar desde otras apps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat säilyttää kopioimasi, salli Glance kohdassa Tietosuoja ja suojaus, Sijoita muista apeista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour garder ce que vous copiez, autorisez Glance dans Confidentialité et sécurité, sous Coller depuis d’autres apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לשמור את מה שהעתקת, יש לאשר את Glance בפרטיות ואבטחה, תחת הדבקה מיישומים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी की हुई चीज़ें रखने के लिए, गोपनीयता और सुरक्षा में, अन्य ऐप्स से पेस्ट करें के अंतर्गत Glance को अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste zadržali ono što kopirate, dopustite Glance u odjeljku Privatnost i sigurnost, pod Lijepljenje iz drugih aplikacija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy megmaradjon, amit másol, engedélyezze a Glance-t itt: Adatvédelem és biztonság > Beillesztés más appokból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyimpan yang Anda salin, izinkan Glance di Privasi & Keamanan, pada Tempelkan dari App Lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per conservare ciò che copi, consenti Glance in Privacy e sicurezza, sotto Incolla da altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたものを保持するには、「プライバシーとセキュリティ」の「ほかのアプリからペースト」でGlanceを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 항목을 보관하려면 개인정보 보호 및 보안의 다른 앱에서 붙여넣기에서 Glance를 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyimpan apa yang anda salin, benarkan Glance dalam Privasi & Keselamatan, di bawah Tampal daripada App Lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å beholde det du kopierer, tillat Glance i Personvern og sikkerhet, under Lim inn fra andre apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te bewaren wat je kopieert, sta je Glance toe bij Privacy en beveiliging, onder Plak uit andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zachowywać to, co kopiujesz, zezwól Glance w sekcji Prywatność i ochrona, w części Wklejanie z innych aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para manter o que você copia, permita o Glance em Privacidade e Segurança, em Colar de Outros Apps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para manter o que copia, autorize o Glance em Privacidade e segurança, em Colar de outras aplicações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a păstra ce copiați, permiteți Glance în Intimitate și securitate, la Lipire din alte aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы хранить скопированное, разрешите Glance в разделе «Конфиденциальность и безопасность», пункт «Вставка из других приложений»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete ponechávať, čo kopírujete, povoľte Glance v sekcii Súkromie a bezpečnosť, v časti Vkladanie z iných apiek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite obdržati, kar kopirate, dovolite Glance v razdelku Zasebnost in varnost, pod Lepljenje iz drugih aplikacij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att behålla det du kopierar, tillåt Glance i Integritet och säkerhet, under Klistra in från andra appar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเก็บสิ่งที่คุณคัดลอก ให้อนุญาต Glance ใน ความเป็นส่วนตัวและความปลอดภัย ภายใต้ วางจากแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladıklarınızı tutmak için Gizlilik ve Güvenlik bölümünde, Diğer Uygulamalardan Yapıştır altında Glance’e izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зберігати скопійоване, дозвольте Glance у розділі «Приватність і безпека», пункт «Вставлення з інших програм»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để giữ nội dung bạn sao chép, hãy cho phép Glance trong Quyền riêng tư & Bảo mật, tại Dán từ các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要保留你拷贝的内容，请在“隐私与安全”的“从其他App粘贴”中允许 Glance。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要保留你拷貝的內容，請在「隱私權與安全性」的「從其他App貼上」中允許 Glance。"
          }
        }
      }
    },
    "To paste from the tray, swipe to it, press Clock's and AirDrop's buttons, find the tab a song plays in, and hide macOS's own banners and timer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للصق من الدرج، والتحريك إليه، والضغط على أزرار الساعة وAirDrop، والعثور على علامة التبويب التي تشغل أغنية، وإخفاء لافتات macOS ومؤقته."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per enganxar des de la safata, lliscar-hi, prémer els botons de Rellotge i AirDrop, trobar la pestanya on sona una cançó i ocultar els bàners i el temporitzador del macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vkládání ze zásobníku, přejetí k němu, stisk tlačítek Hodiny a AirDrop, nalezení panelu, kde hraje skladba, a skrytí bannerů a minutky macOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at indsætte fra bakken, skubbe til den, trykke på knapperne i Ur og AirDrop, finde fanen, hvor en sang spiller, og skjule macOS' egne bannere og timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aus der Ablage einzusetzen, dorthin zu streichen, die Tasten von Uhr und AirDrop zu drücken, den Tab mit dem Song zu finden sowie die Banner und den Timer von macOS auszublenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για επικόλληση από τον δίσκο, σάρωση προς αυτόν, πάτημα των κουμπιών του Ρολόι και του AirDrop, εύρεση της καρτέλας όπου παίζει τραγούδι, και απόκρυψη των banner και του χρονομέτρη του macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pegar desde la bandeja, deslizar hasta ella, pulsar los botones del Reloj y de AirDrop, encontrar la pestaña en la que suena una canción y ocultar los avisos y el temporizador de macOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjottimelta sijoittamiseen, sinne pyyhkäisyyn, Kello- ja AirDrop-painikkeiden painamiseen, kappaletta soittavan välilehden löytämiseen sekä macOS:n omien bannereiden ja ajastimen kätkemiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour coller depuis le plateau, y accéder par balayage, appuyer sur les boutons de Horloge et d’AirDrop, trouver l’onglet où joue un morceau, et masquer les bannières et le minuteur de macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להדביק מהמגש, להחליק אליו, ללחוץ על הכפתורים של שעון ו-AirDrop, למצוא את הכרטיסייה שבה שיר מתנגן, ולהסתיר את הבאנרים והטיימר של macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रे से पेस्ट करने, उस पर स्वाइप करने, घड़ी और AirDrop के बटन दबाने, गीत चलाने वाला टैब ढूँढने और macOS के अपने बैनर व टाइमर छिपाने के लिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za lijepljenje iz ladice, povlačenje do nje, pritisak tipki u appovima Sat i AirDrop, pronalazak kartice u kojoj svira pjesma te skrivanje bannera i timera sustava macOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tálcáról való beillesztéshez, az odalegyintéshez, a(z) Óra és az AirDrop gombjainak megnyomásához, a dalt játszó lap megtalálásához, valamint a macOS saját értesítéseinek és időzítőjének elrejtéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menempel dari baki, menggesek ke sana, menekan tombol Jam dan AirDrop, menemukan tab tempat lagu diputar, serta menyembunyikan spanduk dan timer macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per incollare dal vassoio, scorrere fino ad esso, premere i pulsanti di Orologio e AirDrop, trovare il pannello in cui suona un brano e nascondere banner e timer di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレイからのペースト、トレイへのスワイプ、時計とAirDropのボタン操作、曲が再生中のタブの検索、macOSのバナーとタイマーの非表示に使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트레이에서 붙여넣기, 트레이로 쓸어넘기기, 시계 및 AirDrop 버튼 누르기, 노래가 재생 중인 탭 찾기, macOS 배너와 타이머 가리기에 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menampal daripada dulang, meleret ke sana, menekan butang Jam dan AirDrop, mencari tab tempat lagu dimainkan, dan menyembunyikan sepanduk dan pemasa macOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å lime inn fra brettet, sveipe til det, trykke på knappene i Klokke og AirDrop, finne fanen der en sang spilles, og skjule bannerne og timeren til macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om vanuit de lade te plakken, ernaartoe te vegen, de knoppen van Klok en AirDrop in te drukken, het tabblad te vinden waar een nummer speelt en de banners en timer van macOS te verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby wklejać z tacki, przesuwać do niej, naciskać przyciski Zegar i AirDrop, znajdować kartę, w której gra utwór, oraz ukrywać banery i minutnik macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colar da bandeja, deslizar até ela, pressionar os botões do Relógio e do AirDrop, encontrar a aba em que uma música toca e ocultar os avisos e o timer do macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colar a partir da bandeja, deslizar até ela, premir os botões do Relógio e do AirDrop, encontrar o separador onde uma música toca e ocultar as faixas e o temporizador do próprio macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a lipi din tavă, a glisa la ea, a apăsa butoanele din Ceas și AirDrop, a găsi fila în care se redă o melodie și a ascunde bannerele și temporizatorul macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы вставлять из лотка, смахивать к нему, нажимать кнопки в «Часы» и AirDrop, находить вкладку с песней и скрывать баннеры и таймер macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vkladanie zo zásobníka, potiahnutie k nemu, stláčanie tlačidiel Hodiny a AirDrop, nájdenie panela, kde hrá skladba, a skrytie bannerov a minútky macOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za lepljenje s pladnja, podrsanje do njega, pritiskanje gumbov v aplikacijah Ura in AirDrop, iskanje zavihka s skladbo ter skrivanje pasic in časovnika macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att klistra in från brickan, svepa till den, trycka på knapparna i Klocka och AirDrop, hitta fliken där en låt spelas och gömma macOS egna banderoller och timer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อวางจากถาด ปัดไปยังถาด กดปุ่มของนาฬิกาและ AirDrop ค้นหาแถบที่กำลังเล่นเพลง และซ่อนแบนเนอร์และตัวตั้งเวลาของ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepsiden yapıştırmak, tepsiye kaydırmak, Saat ve AirDrop düğmelerine basmak, şarkının çaldığı sekmeyi bulmak ve macOS’in kendi başlıklarını ve zamanlayıcısını gizlemek için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вставляти з лотка, змахувати до нього, натискати кнопки в «Годинник» та AirDrop, знаходити вкладку з піснею і ховати банери й таймер macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dán từ khay, vuốt tới khay, nhấn các nút của Đồng hồ và AirDrop, tìm tab đang phát bài hát, và ẩn biểu ngữ và hẹn giờ của macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于从托盘粘贴、轻扫到托盘、按下时钟和隔空投送的按钮、查找正在播放歌曲的标签页，以及隐藏 macOS 自身的横幅和定时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於從托盤貼上、滑動到托盤、按下時鐘和 AirDrop 的按鈕、尋找正在播放歌曲的標籤頁，以及隱藏 macOS 本身的橫幅和計時器。"
          }
        }
      }
    },
    "Track Position": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موضع المسار"
          }
        },
        "ca": {
          "stringUnit": {
