        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance tidak dapat melihat apa yang anda salin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan ikke se hva du kopierer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan niet zien wat je kopieert"
          }
        },
        "pl": {
