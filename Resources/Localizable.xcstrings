    "Shows AirPods and Beats as they connect, and sound going to AirPlay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض AirPods وBeats عند توصيلها، والصوت المرسل إلى AirPlay."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els AirPods i els Beats en connectar-se, i el so que va a AirPlay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí AirPods a Beats při připojení a zvuk posílaný přes AirPlay."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser AirPods og Beats, når de tilsluttes, og lyd, der går til AirPlay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt AirPods und Beats beim Verbinden, und Ton, der an AirPlay geht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τα AirPods και Beats κατά τη σύνδεση, και τον ήχο που πηγαίνει στο AirPlay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los AirPods y Beats al conectarse, y el sonido que va a AirPlay."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää AirPodsit ja Beatsit yhdistettäessä sekä AirPlayhin menevän äänen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les AirPods et les Beats à leur connexion, et le son envoyé vers AirPlay."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג AirPods ו-Beats בזמן החיבור, וצליל שעובר ל-AirPlay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट होते समय AirPods और Beats दिखाता है, और AirPlay पर जाने वाली ध्वनि भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje AirPods i Beats pri povezivanju te zvuk koji ide na AirPlay."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatja az AirPodsot és a Beatset csatlakozáskor, és az AirPlayre menő hangot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan AirPods dan Beats saat tersambung, dan suara yang menuju AirPlay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra AirPods e Beats quando si connettono, e il suono inviato ad AirPlay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPodsとBeatsの接続時とAirPlayへの音声を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods 및 Beats가 연결될 때와 AirPlay로 가는 사운드를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan AirPods dan Beats semasa disambungkan, dan bunyi yang pergi ke AirPlay."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser AirPods og Beats når de kobles til, og lyd som går til AirPlay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont AirPods en Beats als ze verbinden, en geluid dat naar AirPlay gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje AirPods i Beats podczas łączenia oraz dźwięk wysyłany przez AirPlay."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra AirPods e Beats ao conectar, e o som enviado por AirPlay."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os AirPods e os Beats quando se ligam, e o som enviado por AirPlay."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată AirPods și Beats când se conectează și sunetul trimis la AirPlay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает AirPods и Beats при подключении и звук, идущий на AirPlay."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí AirPods a Beats pri pripojení a zvuk posielaný cez AirPlay."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaže AirPods in Beats ob povezavi ter zvok, ki gre na AirPlay."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar AirPods och Beats när de ansluts, och ljud som går till AirPlay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง AirPods และ Beats เมื่อเชื่อมต่อ และเสียงที่ส่งไปยัง AirPlay"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods ve Beats’i bağlanırken, AirPlay’e giden sesi de gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує AirPods і Beats під час під’єднання та звук, що йде на AirPlay."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện AirPods và Beats khi kết nối, và âm thanh chuyển tới AirPlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示连接时的 AirPods 和 Beats，以及传到隔空播放的声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示連接時的 AirPods 和 Beats，以及傳到 AirPlay 的聲音。"
          }
        }
      }
    },
    "Shows calls coming in and the call you're on, in place of macOS's popup.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المكالمات الواردة والمكالمة الجارية بدلًا من نافذة macOS المنبثقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra les trucades entrants i la trucada en curs, en lloc de la finestra emergent de macOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje příchozí hovory a probíhající hovor místo vyskakovacího okna macOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser indgående opkald og det opkald, du er i, i stedet for pop op-vinduet i macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eingehende Anrufe und das laufende Gespräch anstelle des Pop-ups von macOS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τις εισερχόμενες κλήσεις και την τρέχουσα κλήση αντί για το αναδυόμενο του macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las llamadas entrantes y la llamada en curso, en lugar de la ventana emergente de macOS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää saapuvat puhelut ja käynnissä olevan puhelun macOS:n ponnahdusikkunan sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les appels entrants et l’appel en cours, à la place de la fenêtre de macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג שיחות נכנסות ואת השיחה הנוכחית, במקום החלון הקופץ של macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS के पॉपअप की जगह आने वाली कॉल और चल रही कॉल दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje dolazne pozive i poziv u tijeku umjesto skočnog prozora macOS-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A macOS felugró ablaka helyett megjeleníti a bejövő hívásokat és a folyamatban lévő hívást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan panggilan masuk dan panggilan yang berlangsung, menggantikan pop-up macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le chiamate in arrivo e quella in corso, al posto del popup di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのポップアップの代わりに、着信と通話中の様子を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 팝업 대신 수신 전화와 진행 중인 통화를 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan panggilan masuk dan panggilan semasa, menggantikan pop timbul macOS."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser innkommende anrop og samtalen du er i, i stedet for hurtigvinduet i macOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont inkomende gesprekken en het huidige gesprek, in plaats van de pop-up van macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje połączenia przychodzące i trwające połączenie zamiast okienka macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as chamadas recebidas e a chamada em curso, no lugar do pop-up do macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as chamadas recebidas e a chamada em curso, em vez do pop-up do macOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează apelurile primite și apelul în curs, în locul ferestrei macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает входящие и текущий звонок вместо всплывающего окна macOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje prichádzajúce hovory a prebiehajúci hovor namiesto vyskakovacieho okna macOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje dohodne klice in trenutni klic namesto pojavnega okna macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar inkommande samtal och pågående samtal i stället för popupfönstret i macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสายเรียกเข้าและสายที่กำลังคุยแทนป๊อปอัปของ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS açılır penceresi yerine gelen aramaları ve devam eden aramayı gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує вхідні й поточний дзвінок замість спливного вікна macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị cuộc gọi đến và cuộc gọi đang diễn ra, thay cho cửa sổ bật lên của macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示来电和正在进行的通话，取代 macOS 的弹窗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示來電和進行中的通話，取代 macOS 的彈出視窗。"
          }
        }
      }
    },
    "Shows files coming in and going out over AirDrop, as they go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الملفات الواردة والصادرة عبر AirDrop أثناء نقلها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra els fitxers que entren i surten per AirDrop mentre avancen."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí příchozí a odchozí soubory přes AirDrop v průběhu přenosu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser arkiver, der kommer ind og går ud via AirDrop, mens det sker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt ein- und ausgehende Dateien über AirDrop, während sie übertragen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τα αρχεία που έρχονται και φεύγουν μέσω AirDrop, καθώς προχωρούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los archivos que entran y salen por AirDrop mientras avanzan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää AirDropilla tulevat ja lähtevät tiedostot niiden edetessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les fichiers entrants et sortants par AirDrop, au fur et à mesure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג קבצים נכנסים ויוצאים ב-AirDrop, תוך כדי ההעברה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop से आने और जाने वाली फ़ाइलें प्रगति के साथ दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje datoteke koje dolaze i odlaze preko AirDropa dok se prenose."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatja az AirDropon érkező és induló fájlokat menet közben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan file yang masuk dan keluar lewat AirDrop, seiring berjalannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i file in entrata e in uscita con AirDrop, mentre procedono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDropで送受信中のファイルを進行に合わせて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop으로 주고받는 파일을 진행에 맞춰 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan fail yang masuk dan keluar melalui AirDrop, semasa ia berjalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser filer som kommer inn og går ut via AirDrop, mens det skjer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont bestanden die via AirDrop binnenkomen en uitgaan, terwijl dat gebeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje pliki przychodzące i wychodzące przez AirDrop na bieżąco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os arquivos entrando e saindo por AirDrop, enquanto avançam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os ficheiros a entrar e a sair por AirDrop, à medida que avançam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată fișierele care vin și pleacă prin AirDrop, pe măsură ce avansează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает входящие и исходящие файлы AirDrop по ходу передачи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí prichádzajúce a odchádzajúce súbory cez AirDrop počas prenosu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaže datoteke, ki prihajajo in odhajajo prek AirDropa, med prenosom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar filer som kommer in och går ut via AirDrop medan det pågår."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงไฟล์ที่เข้าและออกผ่าน AirDrop ขณะดำเนินการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop ile gelen ve giden dosyaları ilerledikçe gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує вхідні та вихідні файли AirDrop під час передавання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tệp đến và đi qua AirDrop trong khi truyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示通过隔空投送传入和传出的文件及其进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示透過 AirDrop 傳入和傳出的檔案及其進度。"
          }
        }
      }
    },
    "Shows in the left button's place while Spotify's DJ plays, to get different picks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر مكان الزر الأيسر أثناء تشغيل DJ في Spotify، للحصول على اختيارات مختلفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apareix al lloc del botó esquerre mentre sona el DJ de Spotify, per obtenir altres seleccions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se místo levého tlačítka, když hraje DJ ve Spotify, a nabízí jiný výběr."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises i stedet for venstre knap, mens Spotifys DJ spiller, så du kan få andre valg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint anstelle der linken Taste, während Spotifys DJ spielt, für eine andere Auswahl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται στη θέση του αριστερού κουμπιού όσο παίζει το DJ του Spotify, για διαφορετικές επιλογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en lugar del botón izquierdo mientras suena el DJ de Spotify, para obtener otras selecciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyy vasemman painikkeen paikalla, kun Spotifyn DJ soittaa, ja hakee muita valintoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’affiche à la place du bouton gauche pendant que le DJ de Spotify joue, pour obtenir d’autres choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופיע במקום הכפתור השמאלי בזמן שה-DJ של Spotify מנגן, כדי לקבל בחירות אחרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify का DJ चलने के दौरान बाएँ बटन की जगह दिखता है, ताकि आप अलग चयन पा सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje se umjesto lijeve tipke dok svira Spotifyjev DJ, za druge odabire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bal oldali gomb helyén jelenik meg, amíg a Spotify DJ-je játszik, hogy más válogatást kérhess."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampil di tempat tombol kiri saat DJ Spotify diputar, untuk mendapatkan pilihan lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare al posto del pulsante sinistro mentre suona il DJ di Spotify, per ottenere altre scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SpotifyのDJが再生中、左のボタンの位置に表示され、別の選曲を頼めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify DJ가 재생되는 동안 왼쪽 버튼 자리에 표시되어 다른 선곡을 받을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipaparkan di tempat butang kiri semasa DJ Spotify dimainkan, untuk mendapatkan pilihan lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises i stedet for venstre knapp mens Spotifys DJ spiller, så du kan få andre valg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschijnt op de plaats van de linkerknop terwijl de DJ van Spotify speelt, voor andere keuzes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się w miejscu lewego przycisku, gdy gra DJ w Spotify, aby uzyskać inny wybór."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no lugar do botão esquerdo enquanto o DJ do Spotify toca, para obter outras escolhas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece no lugar do botão esquerdo enquanto o DJ do Spotify toca, para obter outras escolhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare în locul butonului din stânga cât timp cântă DJ-ul Spotify, pentru a obține alte alegeri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется вместо левой кнопки, пока играет DJ в Spotify, чтобы получить другой выбор."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje sa namiesto ľavého tlačidla, keď hrá DJ v Spotify, a ponúka iný výber."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže se namesto levega gumba, medtem ko igra DJ v Spotifyju, za drug izbor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas i stället för vänster knapp medan Spotifys DJ spelar, så att du kan få andra val."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงแทนปุ่มด้านซ้ายขณะที่ DJ ของ Spotify เล่น เพื่อรับตัวเลือกอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify'ın DJ'i çalarken sol düğmenin yerinde görünür ve farklı seçimler almanızı sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З'являється замість лівої кнопки, поки грає DJ у Spotify, щоб отримати інший вибір."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện ở vị trí nút bên trái khi DJ của Spotify phát, để nhận lựa chọn khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 的 DJ 播放时显示在左侧按钮的位置，可让它换一批选曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify 的 DJ 播放時顯示在左側按鈕的位置，可讓它換一批選曲。"
          }
        }
      }
    },
    "Shows the battery's level when you plug in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض مستوى البطارية عند التوصيل بالطاقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra el nivell de bateria en connectar al corrent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí stav baterie po připojení k napájení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser batteriniveauet, når du tilslutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den Batteriestand beim Anschließen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει το επίπεδο μπαταρίας όταν συνδέετε το ρεύμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el nivel de batería al conectar a la corriente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää akun varaustason, kun liität virtalähteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le niveau de la batterie au branchement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את רמת הסוללה בחיבור לחשמל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लग इन करने पर बैटरी का स्तर दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje razinu baterije kad priključite napajanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatja az akkumulátor szintjét csatlakoztatáskor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan tingkat baterai saat Anda menghubungkan daya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il livello della batteria quando colleghi l’alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源接続時にバッテリー残量を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원에 연결할 때 배터리 잔량을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan tahap bateri apabila anda memalamkan kuasa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser batterinivået når du kobler til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het batterijniveau bij het aansluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje poziom baterii po podłączeniu zasilania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nível da bateria ao conectar na energia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nível da bateria ao ligar à corrente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată nivelul bateriei când conectați alimentarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает уровень заряда при подключении к сети."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí stav batérie po pripojení k napájaniu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaže raven baterije ob priklopu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar batterinivån när du kopplar in."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงระดับแบตเตอรี่เมื่อคุณเสียบปลั๊ก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prize taktığınızda pil düzeyini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує рівень заряду під час під’єднання до живлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện mức pin khi bạn cắm nguồn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接通电源时显示电池电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上電源時顯示電池電量。"
          }
        }
      }
    },
    "Shows the cover on one side of the camera and a waveform on the other.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الغلاف على أحد جانبي الكاميرا وموجة صوتية على الجانب الآخر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la portada a un costat de la càmera i una forma d’ona a l’altre."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí obal na jedné straně kamery a vlnu na druhé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser coveret på den ene side af kameraet og en bølgeform på den anden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das Cover auf einer Seite der Kamera und eine Wellenform auf der anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει το εξώφυλλο στη μία πλευρά της κάμερας και κυματομορφή στην άλλη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la portada a un lado de la cámara y una forma de onda al otro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kannen kameran toisella puolella ja aaltomuodon toisella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la pochette d’un côté de la caméra et une forme d’onde de l’autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את העטיפה בצד אחד של המצלמה וצורת גל בצד השני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा के एक ओर कवर और दूसरी ओर वेवफ़ॉर्म दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje omot s jedne strane kamere i valni oblik s druge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kamera egyik oldalán a borítót, a másikon hullámformát mutat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan sampul di satu sisi kamera dan bentuk gelombang di sisi lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la copertina da un lato della fotocamera e una forma d’onda dall’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの片側にカバー、反対側に波形を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 한쪽에 커버를, 다른 쪽에 파형을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan kulit pada satu sisi kamera dan bentuk gelombang pada sisi lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser omslaget på den ene siden av kameraet og en bølgeform på den andre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont de hoes aan één kant van de camera en een golfvorm aan de andere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje okładkę po jednej stronie kamery, a falę dźwiękową po drugiej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a capa de um lado da câmera e uma forma de onda do outro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a capa de um lado da câmara e uma forma de onda do outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată coperta pe o parte a camerei și o formă de undă pe cealaltă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает обложку с одной стороны камеры и волну с другой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí obal na jednej strane kamery a vlnu na druhej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaže naslovnico na eni strani kamere in valovno obliko na drugi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar omslaget på ena sidan av kameran och en vågform på den andra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงปกด้านหนึ่งของกล้องและรูปคลื่นอีกด้านหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın bir yanında kapağı, diğer yanında dalga biçimini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує обкладинку з одного боку камери і хвилю з іншого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện bìa ở một bên camera và dạng sóng ở bên kia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相机一侧显示封面，另一侧显示波形。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在相機一側顯示封面，另一側顯示波形。"
          }
        }
      }
    },
    "Shows what's going on beside the camera while the notch is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض ما يجري بجانب الكاميرا بينما يكون الشق مغلقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra què passa al costat de la càmera mentre el notch està tancat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí vedle kamery, co se děje, když je výřez zavřený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvad der foregår ved siden af kameraet, mens notchen er lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt neben der Kamera, was gerade passiert, während die Notch geschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει τι συμβαίνει δίπλα στην κάμερα όσο η εγκοπή είναι κλειστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra lo que ocurre junto a la cámara mientras el notch está cerrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää kameran vieressä, mitä tapahtuu, kun lovi on suljettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ce qui se passe à côté de la caméra quand l’encoche est fermée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג מה קורה ליד המצלמה בזמן שהמגרעת סגורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच बंद रहने पर कैमरा के पास दिखाता है कि क्या चल रहा है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje što se događa pored kamere dok je zarez zatvoren."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutatja, mi történik a kamera mellett, amíg a notch zárva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan apa yang terjadi di samping kamera saat takik tertutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cosa succede accanto alla fotocamera mentre il notch è chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチを閉じている間、カメラの横に現在の状況を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치가 닫혀 있는 동안 카메라 옆에 진행 중인 항목을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan apa yang berlaku di sebelah kamera semasa takuk ditutup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hva som skjer ved siden av kameraet mens notchen er lukket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont wat er speelt naast de camera terwijl de notch gesloten is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje obok kamery, co się dzieje, gdy notch jest zamknięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que está acontecendo ao lado da câmera enquanto o notch está fechado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o que se passa ao lado da câmara enquanto o notch está fechado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată ce se întâmplă lângă cameră cât timp notch-ul este închis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает рядом с камерой, что происходит, пока вырез закрыт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí vedľa kamery, čo sa deje, keď je výrez zatvorený."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaže, kaj se dogaja poleg kamere, ko je izrez zaprt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar vad som händer bredvid kameran när notchen är stängd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสิ่งที่เกิดขึ้นข้างกล้องขณะที่รอยบากปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik kapalıyken kameranın yanında neler olduğunu gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує поруч із камерою, що відбувається, поки виріз закритий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện những gì đang diễn ra bên cạnh camera khi phần khuyết đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海关闭时在相机旁显示正在发生的事情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海關閉時在相機旁顯示正在發生的事。"
          }
        }
      }
    },
