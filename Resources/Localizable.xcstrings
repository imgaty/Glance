    "Timers and the stopwatch are Clock's, started there, in Control Center or with Siri.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المؤقتات وساعة الإيقاف من الساعة، وتبدأ من هناك أو من مركز التحكم أو عبر Siri."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els temporitzadors i el cronòmetre són de Rellotge, i s’inicien allà, al Centre de control o amb Siri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutky a stopky patří aplikaci Hodiny, spouští se v ní, v Ovládací centrum nebo pomocí Siri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timere og stopuret hører til Ur og startes der, i Kontrolcenter eller med Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer und Stoppuhr gehören zur App „Uhr“ und werden dort, im Kontrollzentrum oder mit Siri gestartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι χρονομετρητές και το χρονόμετρο ανήκουν στο Ρολόι, ξεκινούν εκεί, στο Κέντρο ελέγχου ή με τη Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temporizadores y el cronómetro son del Reloj, y se inician allí, en el Centro de control o con Siri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastimet ja sekuntikello kuuluvat Kello-apille, ja ne käynnistetään siellä, Ohjauskeskus-keskuksessa tai Sirillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minuteurs et le chronomètre sont ceux de Horloge, lancés depuis cette app, le Centre de contrôle ou Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטיימרים ושעון עצר הם של שעון, ומופעלים שם, במרכז הבקרה או עם Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर और स्टॉपवॉच घड़ी के हैं, और वहीं, कंट्रोल सेंटर में या Siri से शुरू होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeri i štoperica pripadaju appu Sat i pokreću se ondje, u Kontrolni centar ili pomoću Siri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időzítők és a stopperóra a(z) Óra appéi, ott, a(z) Vezérlőközpont helyen vagy Sirivel indíthatók."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer dan stopwatch milik Jam, dimulai di sana, di Pusat Kontrol, atau dengan Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer e cronometro sono di Orologio, avviati lì, da Centro di Controllo o con Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーとストップウォッチは時計のもので、時計、コントロールセンター、またはSiriで開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머와 스톱워치는 시계의 기능으로, 시계, 제어 센터 또는 Siri로 시작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasa dan jam randik milik Jam, dimulakan di sana, dalam Pusat Kawalan atau dengan Siri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Timere og stoppeklokken hører til Klokke og startes der, i Kontrollsenter eller med Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Timers en de stopwatch zijn van Klok, en starten daar, in Bedieningspaneel of met Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutniki i stoper należą do aplikacji Zegar i uruchamia się je tam, w Centrum sterowania lub przez Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Timers e o cronômetro são do Relógio, iniciados lá, na Central de Controle ou com a Siri."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temporizadores e o cronómetro são do Relógio, iniciados lá, na Central de controlo ou com a Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizatoarele și cronometrul sunt ale aplicației Ceas, pornite acolo, în Centru de control sau cu Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймеры и секундомер относятся к приложению «Часы» и запускаются там, в Пункте управления или через Siri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Minútky a stopky patria aplikácii Hodiny, spúšťajú sa v nej, v Ovládacie centrum alebo pomocou Siri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovniki in štoparica pripadajo aplikaciji Ura, zaženejo se tam, v Nadzorno središče ali s Siri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timrar och stoppuret hör till Klocka och startas där, i Kontrollcenter eller med Siri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวตั้งเวลาและนาฬิกาจับเวลาเป็นของนาฬิกา เริ่มได้จากที่นั่น จากศูนย์ควบคุม หรือด้วย Siri"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlayıcılar ve kronometre Saat uygulamasına aittir; orada, Denetim Merkezi içinde veya Siri ile başlatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймери й секундомір належать програмі «Годинник» і запускаються там, у Центр керування або через Siri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hẹn giờ và đồng hồ bấm giờ thuộc Đồng hồ, được bắt đầu tại đó, trong Trung tâm điều khiển hoặc bằng Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时器和秒表属于时钟，可在时钟、控制中心或通过 Siri 启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時器和碼錶屬於時鐘，可在時鐘、控制中心或透過 Siri 啟動。"
          }
        }
      }
    },
    "Timers, AirDrop and more, beside the camera.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المؤقتات وAirDrop والمزيد، بجانب الكاميرا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporitzadors, AirDrop i més, al costat de la càmera."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutky, AirDrop a další vedle kamery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timere, AirDrop og mere ved siden af kameraet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, AirDrop und mehr, neben der Kamera."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρονομετρητές, AirDrop και άλλα, δίπλα στην κάμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizadores, AirDrop y más, junto a la cámara."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajastimet, AirDrop ja muuta kameran vieressä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuteurs, AirDrop et plus, à côté de la caméra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיימרים, AirDrop ועוד, ליד המצלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमर, AirDrop और बहुत कुछ, कैमरा के पास।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeri, AirDrop i više, pored kamere."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Időzítők, AirDrop és más, a kamera mellett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, AirDrop, dan lainnya, di samping kamera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer, AirDrop e altro, accanto alla fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー、AirDropなどをカメラの横に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머, AirDrop 등을 카메라 옆에."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasa, AirDrop dan banyak lagi, di sebelah kamera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Timere, AirDrop og mer, ved siden av kameraet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Timers, AirDrop en meer, naast de camera."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutniki, AirDrop i nie tylko, obok kamery."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Timers, AirDrop e mais, ao lado da câmera."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizadores, AirDrop e mais, ao lado da câmara."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporizatoare, AirDrop și altele, lângă cameră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймеры, AirDrop и другое рядом с камерой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Minútky, AirDrop a ďalšie vedľa kamery."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovniki, AirDrop in še več, poleg kamere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timrar, AirDrop och mer, bredvid kameran."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวตั้งเวลา AirDrop และอื่นๆ ข้างกล้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlayıcılar, AirDrop ve daha fazlası kameranın yanında."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таймери, AirDrop та інше поруч із камерою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hẹn giờ, AirDrop và hơn thế, bên cạnh camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时器、隔空投送等，就在相机旁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時器、AirDrop 等，就在相機旁。"
          }
        }
      }
    },
