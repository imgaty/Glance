    "The tray can't keep what's chosen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للدرج الاحتفاظ بما تم اختياره."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La safata no pot conservar el que has triat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásobník nemůže ponechat vybrané položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakken kan ikke beholde det valgte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ablage kann das Gewählte nicht behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο δίσκος δεν μπορεί να διατηρήσει το επιλεγμένο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja no puede conservar lo elegido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjotin ei voi säilyttää valittua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plateau ne peut pas garder ce qui est choisi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגש לא יכול לשמור את מה שנבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रे चुनी हुई चीज़ नहीं रख सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladica ne može zadržati odabrano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tálca nem tudja megtartani a kiválasztottat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baki tidak dapat menyimpan yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vassoio non può conservare ciò che hai scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したものをトレイに保持できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 트레이에 보관할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dulang tidak dapat menyimpan apa yang dipilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brettet kan ikke beholde det som er valgt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lade kan het gekozene niet bewaren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tacka nie może zachować wybranych rzeczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeja não consegue manter o que foi escolhido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bandeja não consegue manter o que foi escolhido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tava nu poate păstra ce ați ales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лоток не может сохранить выбранное."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásobník nemôže ponechať vybrané položky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pladenj ne more obdržati izbranega."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Brickan kan inte behålla det som valts."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาดไม่สามารถเก็บสิ่งที่เลือกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepsi seçileni tutamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лоток не може зберегти вибране."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khay không thể giữ nội dung đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托盘无法保留所选内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "托盤無法保留所選內容。"
          }
        }
      }
    },
