    "Apps that start playing are added turned on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف التطبيقات التي تبدأ التشغيل وهي مفعَّلة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps que comencen a reproduir s’afegeixen activades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace, které začnou přehrávat, se přidají zapnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, der begynder at spille, tilføjes slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die mit der Wiedergabe beginnen, werden aktiviert hinzugefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές που ξεκινούν αναπαραγωγή προστίθενται ενεργές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que empiezan a reproducir se añaden activadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiston aloittavat apit lisätään päällä olevina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui commencent à jouer sont ajoutées et activées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישומים שמתחילים לנגן נוספים כשהם מופעלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाना शुरू करने वाले ऐप चालू अवस्था में जोड़े जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appovi koji počnu reproducirati dodaju se uključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lejátszást elindító appok bekapcsolva kerülnek a listára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang mulai memutar ditambahkan dalam keadaan aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che iniziano a riprodurre vengono aggiunte attive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生を開始したアプリはオンの状態で追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생을 시작한 앱은 켜진 상태로 추가됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "App yang mula dimainkan ditambah dalam keadaan hidup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper som begynner å spille, legges til slått på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps die gaan afspelen worden ingeschakeld toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje rozpoczynające odtwarzanie są dodawane jako włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que começam a tocar são adicionados ativados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps que começam a reproduzir são adicionadas e ativadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile care încep redarea sunt adăugate activate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, начинающие воспроизведение, добавляются включёнными."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie, ktoré začnú prehrávať, sa pridajú zapnuté."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije, ki začnejo predvajati, so dodane vklopljene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar som börjar spela läggs till påslagna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่เริ่มเล่นจะถูกเพิ่มโดยเปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalmaya başlayan uygulamalar açık olarak eklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми, що починають відтворення, додаються увімкненими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng bắt đầu phát sẽ được thêm và bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始播放的 App 会以打开状态添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始播放的 App 會以開啟狀態加入。"
          }
        }
      }
    },
