    "Removes everything in it. Files stay where they are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل كل ما فيه. تبقى الملفات في مكانها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tot el que conté. Els fitxers es queden on són."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní vše, co v něm je. Soubory zůstanou, kde jsou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner alt på den. Arkiver bliver, hvor de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
