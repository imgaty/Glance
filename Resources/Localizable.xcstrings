    "Glance can't see what you copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ Glance رؤية ما تنسخه"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Glance no pot veure el que copies"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance nevidí, co kopírujete"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan ikke se, hvad du kopierer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kann nicht sehen, was du kopierst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Glance δεν μπορεί να δει τι αντιγράφετε"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance no puede ver lo que copias"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance ei näe, mitä kopioit"
