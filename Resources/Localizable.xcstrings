    "Keeps files you drop on the notch, what you copy, and your screenshots and screen recordings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ بالملفات التي تفلتها على الشق، وما تنسخه، ولقطات الشاشة وتسجيلاتها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva els fitxers que deixes anar al notch, el que copies i les teves captures i gravacions de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechává soubory přetažené na výřez, to, co kopírujete, a vaše snímky a záznamy obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder arkiver, du slipper på notchen, det du kopierer, og dine skærmbilleder og skærmoptagelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält auf der Notch abgelegte Dateien, Kopiertes sowie deine Bildschirmfotos und -aufnahmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρεί τα αρχεία που αφήνετε στην εγκοπή, όσα αντιγράφετε και τα στιγμιότυπα και τις εγγραφές οθόνης σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los archivos que sueltas en el notch, lo que copias y tus capturas y grabaciones de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilyttää lovelle pudottamasi tiedostot, kopioimasi sekä kuvakaappauksesi ja näyttötallenteesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les fichiers déposés sur l’encoche, ce que vous copiez, ainsi que vos captures et enregistrements d’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר קבצים ששחררת על המגרעת, מה שהעתקת, וצילומי המסך והקלטות המסך שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच पर ड्रॉप की हुई फ़ाइलें, कॉपी की हुई चीज़ें, और आपके स्क्रीनशॉट व स्क्रीन रिकॉर्डिंग रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržava datoteke ispuštene na zarez, ono što kopirate te vaše snimke i snimanja zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtartja a notchra dobott fájlokat, amit másol, valamint a képernyőképeket és -felvételeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan file yang diletakkan di takik, yang Anda salin, serta jepretan dan rekaman layar Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i file trascinati sul notch, ciò che copi e le tue istantanee e registrazioni dello schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチにドロップしたファイル、コピーしたもの、スクリーンショットと画面収録を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 놓은 파일, 복사한 항목, 스크린샷과 화면 기록을 보관합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan fail yang dilepaskan pada takuk, apa yang anda salin, serta syot layar dan rakaman skrin anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder filer du slipper på notchen, det du kopierer, og skjermbildene og skjermopptakene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart bestanden die je op de notch neerzet, wat je kopieert en je schermafbeeldingen en schermopnamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje pliki upuszczone na notchu, to, co kopiujesz, oraz zrzuty i nagrania ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os arquivos soltos no notch, o que você copia e suas capturas e gravações de tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os ficheiros que larga no notch, o que copia e as suas capturas e gravações de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează fișierele plasate pe notch, ce copiați și capturile și înregistrările dvs. de ecran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит файлы, перетащенные на вырез, скопированное, снимки и записи экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponecháva súbory pretiahnuté na výrez, to, čo kopírujete, a vaše snímky a záznamy obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obdrži datoteke, spuščene na izrez, kar kopirate, ter vaše posnetke zaslona in zaslonske posnetke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller filer du släpper på notchen, det du kopierar och dina skärmavbilder och skärminspelningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไฟล์ที่คุณวางบนรอยบาก สิ่งที่คุณคัดลอก และภาพหน้าจอกับการบันทึกหน้าจอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiğe bıraktığınız dosyaları, kopyaladıklarınızı, ekran resimlerinizi ve ekran kayıtlarınızı tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає файли, перетягнуті на виріз, скопійоване, знімки та записи екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
