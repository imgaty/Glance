    "Briefly shows what starts playing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض لفترة وجيزة ما يبدأ تشغيله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra breument el que comença a sonar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátce ukáže, co začíná hrát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kort, hvad der begynder at spille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt kurz an, was gerade zu spielen beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει για λίγο τι αρχίζει να παίζει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra brevemente lo que empieza a sonar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää hetken, mitä alkaa soida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche brièvement ce qui commence à jouer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג לרגע את מה שמתחיל לנגן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो चलना शुरू हो रहा है उसे कुछ देर दिखाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakratko prikazuje što počinje svirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rövid ideig mutatja, mi kezd el szólni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan sebentar apa yang mulai diputar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra per un attimo ciò che inizia a suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生が始まったものを短く表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생이 시작된 항목을 잠시 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan seketika apa yang mula dimainkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kort hva som begynner å spille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont even wat begint te spelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótko pokazuje, co zaczyna grać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra rapidamente o que começa a tocar."
          }
        },
        "pt-PT": {
