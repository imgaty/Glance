            "value": "Sveip mellom verktøy"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg tussen gereedschappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuwanie między narzędziami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar entre ferramentas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar entre ferramentas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisare între instrumente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахивание между инструментами"
          }
        },
        "sk": {
