    "Everything in the tray is removed. Files stay where they are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة كل ما في الدرج. تبقى الملفات في مكانها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’eliminarà tot el que hi ha a la safata. Els fitxers es queden on són."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše ze zásobníku se odstraní. Soubory zůstanou, kde jsou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt på bakken fjernes. Arkiver bliver, hvor de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in der Ablage wird entfernt. Dateien bleiben, wo sie sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα όσα είναι στον δίσκο θα αφαιρεθούν. Τα αρχεία μένουν όπου είναι."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará todo lo que hay en la bandeja. Los archivos se quedan donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tarjottimella oleva poistetaan. Tiedostot pysyvät paikoillaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui se trouve dans le plateau est retiré. Les fichiers restent où ils sont."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מה שבמגש יוסר. הקבצים יישארו במקומם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रे की हर चीज़ हटा दी जाएगी। फ़ाइलें अपनी जगह पर रहेंगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve iz ladice se uklanja. Datoteke ostaju gdje jesu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tálcán lévő minden eltávolításra kerül. A fájlok a helyükön maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang ada di baki akan dihapus. File tetap di tempatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è nel vassoio verrà rimosso. I file restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレイ内のものがすべて削除されます。ファイルはそのままの場所に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트레이의 모든 항목이 제거됩니다. 파일은 그대로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua dalam dulang akan dikeluarkan. Fail kekal di tempatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt på brettet fjernes. Filene blir der de er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in de lade wordt verwijderd. Bestanden blijven waar ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko z tacki zostanie usunięte. Pliki pozostaną na swoim miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo na bandeja será removido. Os arquivos ficam onde estão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está na bandeja é removido. Os ficheiros ficam onde estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot ce este în tavă va fi eliminat. Fișierele rămân unde sunt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё из лотка будет удалено. Файлы останутся на своих местах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetko zo zásobníka sa odstráni. Súbory zostanú, kde sú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse s pladnja bo odstranjeno. Datoteke ostanejo, kjer so."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt på brickan tas bort. Filer stannar där de är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างในถาดจะถูกเอาออก ไฟล์ยังอยู่ที่เดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepsideki her şey silinir. Dosyalar bulundukları yerde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе з лотка буде вилучено. Файли залишаться на своїх місцях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ trong khay sẽ bị xóa. Tệp vẫn ở nguyên vị trí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托盘中的所有内容都将被移除。文件保留在原位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "托盤中的所有內容都會被移除。檔案會保留在原位置。"
          }
        }
      }
    },
