    "Click the waveform to see the words, lit line by line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على الموجة الصوتية لرؤية الكلمات مضاءة سطرًا بسطر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic a la forma d’ona per veure la lletra il·luminada línia a línia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na vlnu uvidíte text rozsvěcovaný řádek po řádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på bølgeformen for at se teksten lyse op linje for linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf die Wellenform, um den Text Zeile für Zeile leuchten zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στην κυματομορφή για να δείτε τους στίχους να φωτίζονται γραμμή προς γραμμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en la forma de onda para ver la letra, iluminada línea a línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa aaltomuotoa nähdäksesi sanat rivi riviltä valaistuina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur la forme d’onde pour voir les paroles, éclairées ligne par ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ללחוץ על צורת הגל כדי לראות את המילים, מוארות שורה אחר שורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंक्ति दर पंक्ति रोशन बोल देखने के लिए वेवफ़ॉर्म पर क्लिक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
