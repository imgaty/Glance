    "Drop files here to keep them close.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت الملفات هنا لإبقائها قريبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa anar fitxers aquí per tenir-los a mà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte sem soubory a mějte je po ruce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip arkiver her for at have dem lige ved hånden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Dateien hier ab, um sie griffbereit zu haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε αρχεία εδώ για να τα έχετε κοντά σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos aquí para tenerlos cerca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota tiedostoja tähän, niin ne pysyvät lähellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez des fichiers ici pour les garder à portée de main."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשחרר כאן קבצים כדי לשמור אותם בהישג יד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें यहाँ ड्रॉप करें ताकि वे पास रहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispustite datoteke ovdje da ih imate pri ruci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejtse ide a fájlokat, hogy kéznél legyenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan file di sini agar tetap dekat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui i file per tenerli a portata di mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをここにドロップして手元に置いておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 여기에 놓아 가까이 두십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan fail di sini supaya sentiasa dekat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp filer her for å ha dem nær."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep hier bestanden naartoe om ze bij de hand te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść tu pliki, aby mieć je pod ręką."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte arquivos aqui para mantê-los por perto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Largue aqui ficheiros para os manter por perto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasați fișiere aici pentru a le avea la îndemână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите файлы сюда, чтобы держать их под рукой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretiahnite sem súbory a majte ich poruke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite datoteke sem, da jih imate pri roki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp filer här för att ha dem nära till hands."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์ที่นี่เพื่อเก็บไว้ใกล้มือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınınızda tutmak için dosyaları buraya bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть файли сюди, щоб тримати їх під рукою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả tệp vào đây để giữ chúng ở gần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖放到这里以便随手取用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖放到這裡以便隨手取用。"
          }
        }
      }
    },
    "Drop files here. Copies and screenshots show up too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت الملفات هنا. تظهر النسخ ولقطات الشاشة أيضًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa anar fitxers aquí. També hi apareixen còpies i captures de pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte sem soubory. Zobrazí se i kopie a snímky obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip arkiver her. Kopier og skærmbilleder vises også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Dateien hier ab. Kopien und Bildschirmfotos erscheinen ebenfalls."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε αρχεία εδώ. Εμφανίζονται και αντίγραφα και στιγμιότυπα οθόνης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta archivos aquí. También aparecen copias y capturas de pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pudota tiedostoja tähän. Myös kopiot ja kuvakaappaukset näkyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez des fichiers ici. Les copies et captures d’écran apparaissent aussi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשחרר כאן קבצים. גם העתקות וצילומי מסך יופיעו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें यहाँ ड्रॉप करें। कॉपी और स्क्रीनशॉट भी दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispustite datoteke ovdje. Prikazuju se i kopije i snimke zaslona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejtse ide a fájlokat. A másolatok és képernyőképek is megjelennek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan file di sini. Salinan dan jepretan layar juga muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui i file. Compaiono anche copie e istantanee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをここにドロップ。コピーとスクリーンショットも表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 여기에 놓으십시오. 복사한 항목과 스크린샷도 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepaskan fail di sini. Salinan dan syot layar juga muncul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slipp filer her. Kopier og skjermbilder vises også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep hier bestanden naartoe. Kopieën en schermafbeeldingen verschijnen ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść tu pliki. Pojawią się też kopie i zrzuty ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte arquivos aqui. Cópias e capturas de tela também aparecem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Largue aqui ficheiros. Também aparecem cópias e capturas de ecrã."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasați fișiere aici. Apar și copiile și capturile de ecran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите файлы сюда. Здесь же появятся копии и снимки экрана."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretiahnite sem súbory. Zobrazia sa aj kópie a snímky obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite datoteke sem. Prikažejo se tudi kopije in posnetki zaslona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp filer här. Kopior och skärmavbilder visas också."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางไฟล์ที่นี่ สำเนาและภาพหน้าจอจะแสดงด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları buraya bırakın. Kopyalar ve ekran resimleri de görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть файли сюди. Тут також з’являться копії та знімки екрана."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả tệp vào đây. Bản sao và ảnh màn hình cũng hiển thị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件拖放到这里。拷贝内容和截屏也会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案拖放到這裡。拷貝內容和截圖也會顯示。"
          }
        }
      }
    },
