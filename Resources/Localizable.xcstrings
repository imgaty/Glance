    "The notch is opaque while Increase contrast is on in Accessibility settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكون الشق معتمًا بينما يكون زيادة التباين قيد التشغيل في إعدادات تسهيلات الاستخدام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El notch és opac mentre Augmenta el contrast estigui activat a la configuració d’Accessibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výřez je neprůhledný, když je volba Zvýšit kontrast zapnutá v nastavení Zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchen er ugennemsigtig, mens Forøg kontrast er slået til i indstillingerne til Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch ist deckend, solange „Kontrast erhöhen“ in den Einstellungen für Bedienungshilfen aktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγκοπή είναι αδιαφανής όσο το Αύξηση αντίθεσης είναι ενεργό στις ρυθμίσεις Προσβασιμότητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El notch es opaco mientras Aumentar contraste esté activado en los ajustes de Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lovi on peittävä, kun Lisää kontrastia on päällä asetuksissa Käyttöapu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’encoche est opaque tant que Augmenter le contraste est activé dans les réglages Accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המגרעת אטומה כשהגברת הניגודיות מופעל בהגדרות נגישות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐक्सेसिबिलिटी सेटिंग्ज़ में कॉन्ट्रास्ट बढ़ाएँ चालू रहने पर नॉच अपारदर्शी होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarez je neproziran dok je Povećaj kontrast uključeno u postavkama Pristupačnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A notch átlátszatlan, amíg a(z) Kontraszt növelése be van kapcsolva a(z) Kisegítő lehetőségek beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Takik buram saat Tambah kontras aktif di pengaturan Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il notch è opaco quando Aumenta contrasto è attivo nelle impostazioni di Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの設定でコントラストを上げるがオンの間、ノッチは不透明になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 설정에서 대비 증가이(가) 켜져 있는 동안 노치는 불투명합니다."
          }
