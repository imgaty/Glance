    "Requires approval in Login Items & Extensions settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الموافقة في إعدادات عناصر الدخول والملحقات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Requereix aprovació a la configuració de Ítems d’inici de sessió i extensions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje schválení v nastavení Aktivace položek a rozšíření při přihlášení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kræver godkendelse i indstillingerne til Loginemner & udvidelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert eine Genehmigung in den Einstellungen für Anmeldeobjekte & Erweiterungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτεί έγκριση στις ρυθμίσεις Στοιχεία εισόδου και επεκτάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere aprobación en los ajustes de Ítems de inicio y extensiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatii hyväksynnän asetuksissa Kirjautumiskohteet ja laajennukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite une approbation dans les réglages Ouverture et extensions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דורש אישור בהגדרות פריטי התחברות והרחבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगइन आइटम और एक्सटेंशन सेटिंग्ज़ में स्वीकृति चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traži odobrenje u postavkama Stavke za prijavu i ekstenzije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jóváhagyás szükséges a(z) Indítóelemek és bővítmények beállításaiban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan persetujuan di pengaturan Item Masuk & Ekstensi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede l’approvazione nelle impostazioni di Elementi login ed estensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目と機能拡張の設定で承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목 및 확장 프로그램 설정에서 승인이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memerlukan kelulusan dalam seting Item Log Masuk & Sambungan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krever godkjenning i innstillingene for Påloggingsobjekter og utvidelser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist goedkeuring in de instellingen van Inlogonderdelen en extensies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga zatwierdzenia w ustawieniach Rzeczy i rozszerzenia otwierane podczas logowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer aprovação nos ajustes de Itens de Início de Sessão e Extensões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer aprovação nas definições de Início de sessão e extensões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesită aprobare în configurările Lansare la login și extensii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется одобрение в настройках «Объекты входа и расширения»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje schválenie v nastaveniach Položky a rozšírenia spúšťané pri prihlásení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahteva odobritev v nastavitvah Elementi prijave in razširitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver godkännande i inställningarna för Startobjekt och tillägg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องได้รับการอนุมัติในการตั้งค่ารายการเข้าสู่ระบบและส่วนขยาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum Açma Öğeleri ve Genişletmeler ayarlarında onay gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібне схвалення в параметрах «Автозапуск і розширення»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần phê duyệt trong cài đặt Mục đăng nhập & Phần mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“登录项与扩展”设置中批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在「登入項目與延伸功能」設定中核准。"
          }
        }
      }
    },
