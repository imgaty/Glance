          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep mellan verktyg"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดระหว่างเครื่องมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlar arasında kaydır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахування між інструментами"
          }
