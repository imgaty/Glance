          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson a hullámformára, és a dalszöveg soronként világít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik bentuk gelombang untuk melihat lirik menyala baris demi baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla forma d’onda per vedere il testo, illuminato riga per riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
