    "Turn on Glance Tray, under Extensions in Sharing, to share pictures, links and files to the tray.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Glance Tray، ضمن الملحقات في المشاركة، لمشاركة الصور والروابط والملفات إلى الدرج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Glance Tray, a Extensions de Ús compartit, per compartir imatges, enllaços i fitxers amb la safata."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Glance Tray v části Rozšíření v sekci Sdílení a sdílejte obrázky, odkazy a soubory do zásobníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Glance Tray til under Udvidelser i Deling for at dele billeder, links og arkiver til bakken."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Glance Tray unter Erweiterungen bei Teilen, um Bilder, Links und Dateien in die Ablage zu teilen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Glance Tray, στο Επεκτάσεις της ενότητας Κοινή χρήση, για κοινή χρήση εικόνων, συνδέσμων και αρχείων στον δίσκο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Glance Tray, en Extensiones de Compartir, para compartir imágenes, enlaces y archivos con la bandeja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Glance Tray päälle kohdassa Jakaminen, Laajennukset, jos haluat jakaa kuvia, linkkejä ja tiedostoja tarjottimelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Glance Tray, sous Extensions dans Partage, pour partager images, liens et fichiers vers le plateau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את Glance Tray, תחת הרחבות בשיתוף, כדי לשתף תמונות, קישורים וקבצים למגש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रे में चित्र, लिंक और फ़ाइलें शेयर करने के लिए शेयरिंग के एक्सटेंशन में Glance Tray चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite Glance Tray pod Ekstenzije u odjeljku Dijeljenje za dijeljenje slika, linkova i datoteka u ladicu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a Glance Trayt itt: Megosztás > Bővítmények, és képeket, hivatkozásokat, fájlokat oszthat meg a tálcára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Glance Tray, pada Ekstensi di Berbagi, untuk membagikan gambar, tautan, dan file ke baki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Glance Tray, sotto Estensioni in Condivisione, per condividere immagini, link e file nel vassoio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「共有」の「拡張」でGlance Trayをオンにすると、画像、リンク、ファイルをトレイに共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유의 확장 프로그램에서 Glance Tray를 켜면 사진, 링크, 파일을 트레이로 공유할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Glance Tray, di bawah Sambungan dalam Perkongsian, untuk berkongsi gambar, pautan dan fail ke dulang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Glance Tray, under Utvidelser i Deling, for å dele bilder, lenker og filer til brettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Glance Tray in, onder Extensies bij Delen, om afbeeldingen, links en bestanden met de lade te delen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Glance Tray w części Rozszerzenia sekcji Udostępnianie, aby udostępniać obrazki, łącza i pliki na tackę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Glance Tray, em Extensões de Compartilhamento, para compartilhar imagens, links e arquivos com a bandeja."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Glance Tray, em Extensões de Partilha, para partilhar imagens, ligações e ficheiros para a bandeja."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activați Glance Tray, la Extensii din Partajare, pentru a partaja imagini, linkuri și fișiere în tavă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Glance Tray в разделе «Расширения», пункт «Общий доступ», чтобы отправлять в лоток изображения, ссылки и файлы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite Glance Tray v časti Rozšírenia v sekcii Zdieľanie a zdieľajte obrázky, odkazy a súbory do zásobníka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopite Glance Tray pod Razširitve v razdelku Deljenje za deljenje slik, povezav in datotek na pladenj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Glance Tray, under Tillägg i Delning, för att dela bilder, länkar och filer till brickan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Glance Tray ภายใต้ส่วนขยายในการแชร์ เพื่อแชร์รูปภาพ ลิงก์ และไฟล์ไปยังถาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepsiye resim, bağlantı ve dosya paylaşmak için Paylaşma içindeki Genişletmeler altında Glance Tray’i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Glance Tray у розділі «Розширення», пункт «Поширення», щоб надсилати в лоток зображення, посилання і файли."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Glance Tray, tại Phần mở rộng trong Chia sẻ, để chia sẻ ảnh, liên kết và tệp vào khay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“共享”的“扩展”中打开 Glance Tray，即可将图片、链接和文件共享到托盘。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「分享」的「延伸功能」中開啟 Glance Tray，即可將圖片、連結和檔案分享到托盤。"
          }
        }
      }
    },
