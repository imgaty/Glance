    "Open the notch to see what almost any app is playing, with its cover, its controls and the lyrics.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الشق لترى ما يشغّله أي تطبيق تقريبًا، مع الغلاف وعناصر التحكم والكلمات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el notch per veure què reprodueix gairebé qualsevol app, amb la portada, els controls i la lletra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete výřez a uvidíte, co hraje téměř každá aplikace, s obalem, ovládáním a textem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn notchen for at se, hvad næsten enhver app spiller, med cover, betjening og sangtekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Notch und sieh, was fast jede App gerade spielt, mit Cover, Bedienelementen und Text."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την εγκοπή για να δείτε τι παίζει σχεδόν κάθε εφαρμογή, με εξώφυλλο, χειριστήρια και στίχους."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el notch para ver lo que reproduce casi cualquier app, con su portada, sus controles y la letra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa lovi nähdäksesi, mitä lähes mikä tahansa app toistaa, kansineen, säätimineen ja sanoineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’encoche pour voir ce que joue presque n’importe quelle app, avec sa pochette, ses commandes et les paroles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את המגרעת כדי לראות מה כמעט כל יישום מנגן, עם העטיפה, הפקדים והמילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग किसी भी ऐप में क्या चल रहा है, यह कवर, नियंत्रण और बोल के साथ देखने के लिए नॉच खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite zarez i pogledajte što svira gotovo svaki app, s omotom, kontrolama i tekstom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a notchot, és láthatja, mit játszik szinte bármely app, borítóval, vezérlőkkel és dalszöveggel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka takik untuk melihat apa yang diputar hampir semua app, dengan sampul, kontrol, dan liriknya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il notch per vedere cosa sta riproducendo quasi ogni app, con copertina, controlli e testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチを開くと、ほぼすべてのアプリの再生中の曲を、カバー、コントロール、歌詞付きで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 열면 거의 모든 앱에서 재생 중인 항목을 커버, 제어기 및 가사와 함께 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka takuk untuk melihat apa yang dimainkan oleh hampir semua app, dengan kulit, kawalan dan liriknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne notchen for å se hva nesten hvilken som helst app spiller, med omslag, kontroller og sangtekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de notch om te zien wat bijna elke app afspeelt, met hoes, bediening en songtekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz notch, aby zobaczyć, co gra niemal każda aplikacja, z okładką, sterowaniem i tekstem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o notch para ver o que quase qualquer app está tocando, com capa, controles e letra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o notch para ver o que quase qualquer app está a reproduzir, com a capa, os controlos e a letra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți notch-ul pentru a vedea ce redă aproape orice aplicație, cu copertă, comenzi și versuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте вырез, чтобы видеть, что играет почти любое приложение, с обложкой, управлением и текстом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte výrez a uvidíte, čo hrá takmer každá aplikácia, s obalom, ovládaním a textom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite izrez in vidite, kaj predvaja skoraj vsaka aplikacija, z naslovnico, kontrolniki in besedilom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna notchen för att se vad nästan vilken app som helst spelar, med omslag, reglage och låttext."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดรอยบากเพื่อดูว่าแอปแทบทุกแอปกำลังเล่นอะไร พร้อมปก ตัวควบคุม และเนื้อเพลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse her uygulamanın ne çaldığını kapağı, denetimleri ve sözleriyle görmek için çentiği açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте виріз, щоб бачити, що відтворює майже будь-яка програма, з обкладинкою, керуванням і текстом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở phần khuyết để xem gần như mọi ứng dụng đang phát gì, với bìa, điều khiển và lời bài hát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开刘海即可查看几乎任何 App 正在播放的内容，包括封面、控制项和歌词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟瀏海即可查看幾乎任何 App 正在播放的內容，包括封面、控制項目和歌詞。"
          }
        }
      }
    },
