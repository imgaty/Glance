          "stringUnit": {
            "state": "translated",
            "value": "Glisați la stânga sau la dreapta cu două degete."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните влево или вправо двумя пальцами."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite doľava alebo doprava dvoma prstami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsajte levo ali desno z dvema prstoma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt vänster eller höger med två fingrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดซ้ายหรือขวาด้วยสองนิ้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki parmakla sola veya sağa kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахніть ліворуч або праворуч двома пальцями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang trái hoặc phải bằng hai ngón."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两根手指向左或向右轻扫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用兩指向左或向右滑動。"
          }
        }
      }
    },
