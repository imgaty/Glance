        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch fica opaco enquanto Aumentar contraste estiver ativado nos ajustes de Acessibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch fica opaco enquanto Aumentar contraste estiver ativado nas definições de Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch-ul este opac cât timp Sporire contrast este activat în configurările Accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
