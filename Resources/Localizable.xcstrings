            "state": "translated",
            "value": "Ejtse ide a fájlokat. A képernyőképek is megjelennek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan file di sini. Jepretan layar juga muncul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui i file. Compaiono anche le istantanee."
          }
        },
