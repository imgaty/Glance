    "Tints the notch with the cover's colors, instead of your Mac's accent color.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلوّن الشق بألوان الغلاف، بدلًا من لون التمييز في جهاز Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenyeix el notch amb els colors de la portada, en lloc del color d’èmfasi del teu Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Barví výřez barvami obalu místo zvýrazňovací barvy vašeho Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Farver notchen med coverets farver i stedet for din Macs fremhævningsfarve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Notch in den Farben des Covers statt in der Akzentfarbe deines Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρωματίζει την εγκοπή με τα χρώματα του εξωφύλλου, αντί για το χρώμα έμφασης του Mac σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe el notch con los colores de la portada, en lugar del color de realce de tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Värittää loven kannen väreillä Macin korostusvärin sijaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte l’encoche avec les couleurs de la pochette, au lieu de la couleur d’accentuation de votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צובע את המגרעת בצבעי העטיפה, במקום בצבע ההדגשה של ה-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Mac के ऐक्सेंट रंग के बजाय कवर के रंगों से नॉच को रंगता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boji zarez bojama omota umjesto istaknute boje vašeg Maca."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A notchot a borító színeire színezi a Mac kiemelőszíne helyett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewarnai takik dengan warna sampul, bukan warna aksen Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il notch con i colori della copertina, invece del colore di evidenziazione del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのアクセントカラーの代わりにカバーの色でノッチに色を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 강조 색상 대신 커버의 색상으로 노치에 색을 입힙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mewarnakan takuk dengan warna kulit, bukan warna aksen Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Farger notchen med omslagets farger i stedet for Macens uthevingsfarge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleurt de notch met de kleuren van de hoes, in plaats van de accentkleur van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Barwi notch kolorami okładki zamiast koloru akcentu Twojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o notch com as cores da capa, em vez da cor de destaque do seu Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore o notch com as cores da capa, em vez da cor de destaque do seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Colorează notch-ul cu culorile copertei, în locul culorii de accent a Mac-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрашивает вырез в цвета обложки вместо акцентного цвета вашего Mac."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbí výrez farbami obalu namiesto farby zvýraznenia vášho Macu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obarva izrez z barvami naslovnice namesto poudarjene barve vašega Maca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Färgar notchen med omslagets färger, i stället för din Macs accentfärg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่สีรอยบากด้วยสีของปก แทนสีเน้นของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiği Mac’inizin vurgu rengi yerine kapağın renkleriyle renklendirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фарбує виріз у кольори обкладинки замість кольору акценту вашого Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tô màu phần khuyết bằng màu của bìa, thay vì màu nhấn của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用封面的颜色为刘海着色，而不是 Mac 的强调色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用封面的顏色為瀏海上色，而不是 Mac 的強調色。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tints the notch with the cover's colours, instead of your Mac's accent colour."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Tints the notch with the cover's colours, instead of your Mac's accent colour."
          }
        }
      }
    },
