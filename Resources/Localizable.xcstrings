    "Passwords and other private items are never kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم أبدًا الاحتفاظ بكلمات السر والعناصر الخاصة الأخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contrasenyes i altres ítems privats no es conserven mai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesla a další soukromé položky se nikdy neponechávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangskoder og andre private emner beholdes aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter und andere private Objekte werden nie behalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνθηματικοί κωδικοί και άλλα ιδιωτικά στοιχεία δεν διατηρούνται ποτέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas y otros ítems privados nunca se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salasanoja ja muita yksityisiä kohteita ei koskaan säilytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe et autres éléments privés ne sont jamais gardés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיסמאות ופריטים פרטיים אחרים לעולם לא נשמרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड और अन्य निजी आइटम कभी नहीं रखे जाते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinke i druge privatne stavke nikad se ne zadržavaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jelszavak és más privát elemek sosem maradnak meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi dan item pribadi lainnya tidak pernah disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Password e altri elementi privati non vengono mai conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードなどのプライベートな項目は保持されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 및 기타 개인 항목은 보관되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata laluan dan item peribadi lain tidak pernah disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Passord og andre private objekter beholdes aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachtwoorden en andere privéonderdelen worden nooit bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasła i inne prywatne rzeczy nigdy nie są zachowywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Senhas e outros itens privados nunca são mantidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras-passe e outros itens privados nunca são mantidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Parolele și alte articole private nu sunt păstrate niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароли и другие личные данные никогда не хранятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
