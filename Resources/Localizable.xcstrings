    "For the shuffle, repeat and volume controls. Repeating one song also takes Accessibility.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعناصر التحكم في الترتيب العشوائي والتكرار ومستوى الصوت. يتطلب تكرار أغنية واحدة أيضًا تسهيلات الاستخدام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per als controls d’aleatori, repetició i volum. Repetir una cançó també requereix Accessibilitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ovládání náhodného přehrávání, opakování a hlasitosti. Opakování jedné skladby vyžaduje také Zpřístupnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til betjening af bland, gentag og lydstyrke. At gentage én sang kræver også Tilgængelighed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Zufallswiedergabe, Wiederholen und Lautstärke. Einen Song zu wiederholen braucht auch Bedienungshilfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τα χειριστήρια τυχαίας σειράς, επανάληψης και έντασης. Η επανάληψη ενός τραγουδιού απαιτεί και Προσβασιμότητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para los controles de aleatorio, repetición y volumen. Repetir una canción también requiere Accesibilidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekoitus-, toisto- ja äänenvoimakkuussäätimille. Yhden kappaleen toisto vaatii myös Käyttöapu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les commandes de lecture aléatoire, de répétition et de volume. Répéter un morceau nécessite aussi Accessibilité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עבור פקדי הערבוב, החזרה ועוצמת הקול. חזרה על שיר אחד דורשת גם נגישות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शफ़ल, दोहराएँ और वॉल्यूम नियंत्रणों के लिए। एक गीत दोहराने के लिए ऐक्सेसिबिलिटी भी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za kontrole nasumične reprodukcije, ponavljanja i glasnoće. Ponavljanje jedne pjesme traži i Pristupačnost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A véletlen sorrend, ismétlés és hangerő vezérléséhez. Egy dal ismétléséhez Kisegítő lehetőségek is kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kontrol acak, ulangi, dan volume. Mengulangi satu lagu juga memerlukan Aksesibilitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i controlli di riproduzione casuale, ripetizione e volume. Ripetere un brano richiede anche Accessibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャッフル、リピート、音量のコントロール用。1曲リピートにはアクセシビリティも必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임의 재생, 반복 및 음량 제어용입니다. 한 곡 반복에는 손쉬운 사용도 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk kawalan kocok, ulang dan kelantangan. Mengulang satu lagu juga memerlukan Kebolehcapaian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For kontrollene for tilfeldig rekkefølge, gjenta og volum. Å gjenta én sang krever også Tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de regelaars van willekeurig, herhalen en volume. Eén nummer herhalen vereist ook Toegankelijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do sterowania losowaniem, powtarzaniem i głośnością. Powtarzanie jednego utworu wymaga też Dostępność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para os controles de aleatório, repetição e volume. Repetir uma música também requer Acessibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para os controlos de aleatório, repetir e volume. Repetir uma música também requer Acessibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru comenzile de amestecare, repetare și volum. Repetarea unei melodii necesită și Accesibilitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перемешивания, повтора и громкости. Для повтора одной песни также нужен доступ «Универсальный доступ»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovládanie náhodného prehrávania, opakovania a hlasitosti. Opakovanie jednej skladby vyžaduje aj Prístupnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za kontrolnike naključnega predvajanja, ponavljanja in glasnosti. Ponavljanje ene skladbe zahteva tudi Dostopnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För reglagen för blandning, upprepning och volym. Att upprepa en låt kräver också Hjälpmedel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับตัวควบคุมการสุ่ม การเล่นซ้ำ และระดับเสียง การเล่นซ้ำเพลงเดียวต้องใช้การช่วยการเข้าถึงด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırma, tekrarlama ve ses denetimleri için. Bir şarkıyı tekrarlamak için Erişilebilirlik de gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перемішування, повтору та гучності. Для повтору однієї пісні також потрібен доступ «Доступність»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành cho điều khiển trộn bài, lặp lại và âm lượng. Lặp lại một bài cũng cần Trợ năng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于随机播放、重复和音量控制。重复单曲还需要无障碍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於隨機播放、重複和音量控制項目。重複單曲還需要輔助使用。"
          }
        }
      }
    },
