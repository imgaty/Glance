        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt giữa các công cụ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具之间轻扫"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具之間滑動"
          }
        }
      }
    },
    "Swipe down with two fingers to open, and up to close or to swipe a live activity away.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك بإصبعين لأسفل للفتح، ولأعلى للإغلاق أو لإبعاد نشاط مباشر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca cap avall amb dos dits per obrir, i cap amunt per tancar o apartar una activitat en directe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte dvěma prsty dolů pro otevření a nahoru pro zavření nebo odsunutí živé aktivity."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub ned med to fingre for at åbne, og op for at lukke eller skubbe en liveaktivitet væk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche mit zwei Fingern nach unten zum Öffnen, nach oben zum Schließen oder um eine Live-Aktivität wegzuwischen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε προς τα κάτω με δύο δάχτυλα για άνοιγμα, και προς τα πάνω για κλείσιμο ή για απομάκρυνση ζωντανής δραστηριότητας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo con dos dedos para abrir, y hacia arriba para cerrar o descartar una actividad en vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa pyyhkäisemällä alas kahdella sormella, ja sulje tai pyyhkäise livetoiminta pois pyyhkäisemällä ylös."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le bas avec deux doigts pour ouvrir, et vers le haut pour fermer ou écarter une activité en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להחליק למטה בשתי אצבעות לפתיחה, ולמעלה לסגירה או להרחקת פעילות בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलने के लिए दो उँगलियों से नीचे स्वाइप करें, और बंद करने या लाइव ऐक्टिविटी हटाने के लिए ऊपर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite prema dolje s dva prsta za otvaranje, a prema gore za zatvaranje ili uklanjanje aktivnosti uživo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legyintsen le két ujjal a megnyitáshoz, fel a bezáráshoz vagy egy élő tevékenység elsöpréséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek ke bawah dengan dua jari untuk membuka, dan ke atas untuk menutup atau menyingkirkan aktivitas langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in basso con due dita per aprire, e in alto per chiudere o scartare un’attività live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指で下にスワイプして開き、上にスワイプして閉じるかライブアクティビティを消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 아래로 쓸어 열고, 위로 쓸어 닫거나 실시간 현황을 치웁니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke bawah dengan dua jari untuk membuka, dan ke atas untuk menutup atau meleret pergi aktiviti langsung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip ned med to fingre for å åpne, og opp for å lukke eller sveipe bort en liveaktivitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg met twee vingers omlaag om te openen, en omhoog om te sluiten of een live-activiteit weg te vegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń dwoma palcami w dół, aby otworzyć, a w górę, aby zamknąć lub odsunąć aktywność na żywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para baixo com dois dedos para abrir, e para cima para fechar ou dispensar uma atividade ao vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para baixo com dois dedos para abrir, e para cima para fechar ou afastar uma atividade em direto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați în jos cu două degete pentru a deschide și în sus pentru a închide sau a înlătura o activitate live."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вниз двумя пальцами, чтобы открыть, и вверх, чтобы закрыть или смахнуть живое действие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite dvoma prstami nadol na otvorenie a nahor na zatvorenie alebo odsunutie živej aktivity."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsajte navzdol z dvema prstoma za odpiranje in navzgor za zapiranje ali odstranitev dejavnosti v živo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep nedåt med två fingrar för att öppna, och uppåt för att stänga eller svepa bort en liveaktivitet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดลงด้วยสองนิ้วเพื่อเปิด และปัดขึ้นเพื่อปิดหรือปัดกิจกรรมสดออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açmak için iki parmakla aşağı, kapatmak veya bir canlı etkinliği atmak için yukarı kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахніть униз двома пальцями, щоб відкрити, і вгору, щоб закрити або змахнути активність наживо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt xuống bằng hai ngón để mở, và lên để đóng hoặc vuốt đi một hoạt động trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用两根手指向下轻扫打开，向上轻扫关闭或移走实时活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用兩指向下滑動開啟，向上滑動關閉或移開即時動態。"
          }
        }
      }
    },
    "Swipe left or right with three fingers on the open notch, or scroll holding Shift.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك يمينًا أو يسارًا بثلاثة أصابع على الشق المفتوح، أو مرّر مع الضغط على Shift."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca a l’esquerra o a la dreta amb tres dits al notch obert, o desplaça’t mantenint premuda la tecla Majúscules."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejeďte vlevo nebo vpravo třemi prsty na otevřeném výřezu, nebo posouvejte s podrženým Shiftem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skub til venstre eller højre med tre fingre på den åbne notch, eller rul med Skift nede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streiche mit drei Fingern auf der geöffneten Notch nach links oder rechts, oder scrolle mit gedrückter Umschalttaste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαρώστε αριστερά ή δεξιά με τρία δάχτυλα στην ανοιχτή εγκοπή, ή κάντε κύλιση κρατώντας το Shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a izquierda o derecha con tres dedos sobre el notch abierto, o desplázate manteniendo Mayús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäise vasemmalle tai oikealle kolmella sormella avatulla lovella, tai vieritä Vaihto painettuna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez à gauche ou à droite avec trois doigts sur l’encoche ouverte, ou faites défiler en maintenant Maj."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להחליק ימינה או שמאלה בשלוש אצבעות על המגרעת הפתוחה, או לגלול בלחיצה על Shift."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खुले नॉच पर तीन उँगलियों से बाएँ या दाएँ स्वाइप करें, या Shift दबाकर स्क्रोल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povucite ulijevo ili udesno s tri prsta na otvorenom zarezu ili listajte držeći Shift."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Legyintsen balra vagy jobbra három ujjal a nyitott notchon, vagy görgessen a Shift lenyomásával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesek ke kiri atau kanan dengan tiga jari pada takik yang terbuka, atau gulir sambil menahan Shift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a sinistra o a destra con tre dita sul notch aperto, o scorri tenendo premuto Maiusc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたノッチ上で3本指で左右にスワイプするか、Shiftを押しながらスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 노치에서 세 손가락으로 왼쪽이나 오른쪽으로 쓸거나, Shift를 누른 채 스크롤합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Leret ke kiri atau kanan dengan tiga jari pada takuk yang terbuka, atau skrol sambil menahan Shift."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip mot venstre eller høyre med tre fingre på den åpne notchen, eller rull mens du holder Skift."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg met drie vingers naar links of rechts op de geopende notch, of scrol met Shift ingedrukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń w lewo lub w prawo trzema palcami na otwartym notchu albo przewijaj z klawiszem Shift."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda ou direita com três dedos no notch aberto, ou role segurando Shift."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para a esquerda ou direita com três dedos no notch aberto, ou percorra mantendo Shift premida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisați la stânga sau la dreapta cu trei degete pe notch-ul deschis sau derulați ținând apăsat Shift."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните влево или вправо тремя пальцами по открытому вырезу или прокрутите, удерживая Shift."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite doľava alebo doprava troma prstami na otvorenom výreze, alebo posúvajte s podržaným Shiftom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsajte levo ali desno s tremi prsti na odprtem izrezu ali se pomikajte ob držanju tipke Shift."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt vänster eller höger med tre fingrar på den öppna notchen, eller rulla medan du håller ned Skift."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดซ้ายหรือขวาด้วยสามนิ้วบนรอยบากที่เปิดอยู่ หรือเลื่อนขณะกด Shift ค้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık çentikte üç parmakla sola veya sağa kaydırın ya da Shift’e basılı tutarak kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змахніть ліворуч або праворуч трьома пальцями на відкритому вирізі чи прокрутіть, утримуючи Shift."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang trái hoặc phải bằng ba ngón trên phần khuyết đang mở, hoặc cuộn trong khi giữ Shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在打开的刘海上用三根手指向左或向右轻扫，或按住 Shift 键滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開啟的瀏海上用三指向左或向右滑動，或按住 Shift 鍵捲動。"
          }
        }
      }
    },
