          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notchen er ugjennomsiktig mens Øk kontrast er på i innstillingene for Tilgjengelighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notch is ondoorzichtig zolang Verhoog contrast is ingeschakeld bij Toegankelijkheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch jest nieprzezroczysty, gdy opcja Zwiększ kontrast jest włączona w ustawieniach Dostępność."
