          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere eine App, um sie aus der Notch herauszuhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε μια εφαρμογή για να μένει εκτός εγκοπής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva una app para dejarla fuera del notch."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita app pois päältä, niin se pysyy pois lovelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez une app pour la garder hors de l’encoche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לכבות יישום כדי להשאיר אותו מחוץ למגרעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ऐप को नॉच से बाहर रखने के लिए उसे बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključite app da ostane izvan zareza."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsoljon ki egy appot, hogy kimaradjon a notchból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan app agar tidak masuk ke takik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva un’app per tenerla fuori dal notch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをオフにするとノッチに表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 끄면 노치에 표시되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan app supaya kekal di luar takuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av en app for å holde den utenfor notchen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel een app uit om hem buiten de notch te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz aplikację, aby nie pojawiała się w notchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative um app para mantê-lo fora do notch."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative uma app para a manter fora do notch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați o aplicație pentru a o ține în afara notch-ului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите приложение, чтобы оно не попадало в вырез."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite aplikáciu, aby sa vo výreze neobjavovala."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopite aplikacijo, da ostane zunaj izreza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av en app för att hålla den utanför notchen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดแอปเพื่อไม่ให้อยู่ในรอยบาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulamayı çentiğin dışında tutmak için kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть програму, щоб вона не потрапляла у виріз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt một ứng dụng để giữ nó ngoài phần khuyết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭 App 可让其不出现在刘海中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉 App 可讓其不出現在瀏海中。"
          }
        }
      }
    },
    "Turn off Low Power Mode": {
      "localizations": {
        "ar": {
