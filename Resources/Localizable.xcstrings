    "The words, lit line by line as they're sung.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكلمات، مضاءة سطرًا بسطر أثناء غنائها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La lletra, il·luminada línia a línia mentre es canta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text rozsvěcovaný řádek po řádku při zpěvu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten, der lyser op linje for linje, mens den synges."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text, Zeile für Zeile leuchtend, während er gesungen wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι στίχοι φωτίζονται γραμμή προς γραμμή καθώς τραγουδιούνται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra, iluminada línea a línea mientras se canta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanat, rivi riviltä valaistuina niitä laulettaessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles, éclairées ligne par ligne pendant le chant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המילים, מוארות שורה אחר שורה בזמן השירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोल, गाए जाते समय पंक्ति दर पंक्ति रोशन।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst koji svijetli redak po redak dok se pjeva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dalszöveg, soronként világítva éneklés közben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lirik, menyala baris demi baris saat dinyanyikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo, illuminato riga per riga mentre viene cantato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌に合わせて歌詞が1行ずつ光ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래에 맞춰 가사가 한 줄씩 밝아집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lirik, menyala baris demi baris semasa dinyanyikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teksten, som lyser opp linje for linje mens den synges."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De songtekst, regel voor regel oplichtend terwijl die wordt gezongen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst podświetlany wiersz po wierszu podczas śpiewania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra, iluminada linha por linha enquanto é cantada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra, iluminada linha a linha à medida que é cantada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versurile, luminate rând cu rând pe măsură ce sunt cântate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, подсвеченный строка за строкой во время пения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Text rozsvecovaný riadok po riadku pri speve."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besedilo, ki sveti vrstico za vrstico med petjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Texten, tänd rad för rad medan den sjungs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อเพลงสว่างขึ้นทีละบรรทัดขณะร้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sözler, söylendikçe satır satır aydınlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст, підсвічений рядок за рядком під час співу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời bài hát, sáng lên từng dòng khi được hát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌词随歌声逐行点亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞隨歌聲逐行亮起。"
          }
        }
      }
    },
