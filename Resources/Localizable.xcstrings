    "Takes macOS's timer out of the menu bar while the notch shows it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخرج مؤقت macOS من شريط القوائم بينما يعرضه الشق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu el temporitzador del macOS de la barra de menús mentre el notch el mostra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebere minutku macOS z řádku nabídek, když ji výřez zobrazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner macOS' timer fra menulinjen, mens notchen viser den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt den Timer von macOS aus der Menüleiste, solange die Notch ihn zeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάζει τον χρονομέτρη του macOS από τη γραμμή μενού όσο τον δείχνει η εγκοπή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira el temporizador de macOS de la barra de menús mientras el notch lo muestra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa macOS:n ajastimen valikkoriviltä, kun lovi näyttää sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire le minuteur de macOS de la barre des menus tant que l’encoche l’affiche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוציא את הטיימר של macOS משורת התפריטים בזמן שהמגרעת מציגה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच के दिखाने पर macOS का टाइमर मेनू बार से हटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miče timer sustava macOS iz trake s izbornicima dok ga zarez prikazuje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiveszi a macOS időzítőjét a menüsorból, amíg a notch mutatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan timer macOS dari bar menu saat takik menampilkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toglie il timer di macOS dalla barra dei menu mentre il notch lo mostra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチに表示している間、macOSのタイマーをメニューバーから取り除きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치에 표시되는 동안 macOS 타이머를 메뉴 막대에서 뺍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan pemasa macOS daripada bar menu semasa takuk menunjukkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar timeren til macOS ut av menylinjen mens notchen viser den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt de timer van macOS uit de menubalk zolang de notch hem toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabiera minutnik macOS z paska menu, gdy notch go pokazuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira o timer do macOS da barra de menus enquanto o notch o mostra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Retira o temporizador do macOS da barra de menus enquanto o notch o mostra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scoate temporizatorul macOS din bara de meniu cât timp notch-ul îl afișează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает таймер macOS из строки меню, пока вырез его показывает."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni minútku macOS z lišty menu, keď ju výrez zobrazuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umakne časovnik macOS iz menijske vrstice, ko ga kaže izrez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort macOS timer från menyraden medan notchen visar den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาตัวตั้งเวลาของ macOS ออกจากแถบเมนูขณะที่รอยบากแสดงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik gösterirken macOS zamanlayıcısını menü çubuğundan çıkarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибирає таймер macOS зі смуги меню, поки виріз його показує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa hẹn giờ của macOS ra khỏi thanh menu khi phần khuyết hiển thị nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海显示时将 macOS 的定时器移出菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏海顯示時將 macOS 的計時器移出選單列。"
          }
        }
      }
    },
